# Lumen OS system defaults (compiled by `dconf update` in the finalize hook)

[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Light'
icon-theme='WhiteSur'
cursor-theme='WhiteSur-cursors'
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='Fira Code 10'
color-scheme='default'
enable-hot-corners=false
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Inter Bold 10'
focus-mode='click'

[org/gnome/desktop/wm/keybindings]
close=['<Super>q', '<Alt>F4']
minimize=['<Super>m']
switch-applications=['<Super>Tab']
switch-group=['<Super>grave']
switch-input-source=@as []
switch-input-source-backward=@as []

[org/gnome/shell/keybindings]
toggle-overview=['<Super>space']
show-screenshot-ui=['<Shift><Super>5', 'Print']

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/lumen/lumen-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/lumen/lumen-dark.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/lumen/lumen-light.jpg'

[org/gnome/desktop/peripherals/touchpad]
natural-scroll=true
tap-to-click=true
two-finger-scrolling-enabled=true

[org/gnome/desktop/peripherals/mouse]
natural-scroll=true

[org/gnome/mutter]
edge-tiling=true
dynamic-workspaces=true

[org/gnome/shell]
enabled-extensions=['lumen-shell@lumen-os', 'dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com', 'blur-my-shell@aunetx']
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Console.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='999'

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Light'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
autohide=false
intellihide=false
dash-max-icon-size=52
height-fraction=0.9
transparency-mode='FIXED'
background-opacity=0.30
custom-background-color=false
apply-custom-theme=false
custom-theme-shrink=true
show-apps-at-top=true
show-trash=true
show-mounts=false
isolate-workspaces=false
click-action='minimize-or-previews'
running-indicator-style='DOTS'
disable-overview-on-startup=true
animation-time=0.2
border-radius=20

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'

[org/gnome/nautilus/icon-view]
default-zoom-level='large'
